generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusEvento {
  ORCAMENTO
  CONFIRMADO
  REALIZADO
  CANCELADO
}

enum TipoGasto {
  FIXO
  EVENTO
}

model Evento {
  id             String       @id @default(cuid())
  cliente        String
  telefone       String?
  tipoEvento     String
  data           DateTime
  status         StatusEvento @default(ORCAMENTO)
  valor          Float        @default(0)
  valorSinal     Float        @default(0)
  sinalPago      Boolean      @default(false)
  sinalPagoEm    DateTime?
  restantePago   Boolean      @default(false)
  restantePagoEm DateTime?
  observacoes    String?
  planoId        String?
  plano          Plano?       @relation(fields: [planoId], references: [id])
  gastos         Gasto[]
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
}

model Plano {
  id           String   @id @default(cuid())
  nome         String
  descricao    String?
  preco        Float
  itens        String?
  ativo        Boolean  @default(true)
  eventos      Evento[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Gasto {
  id           String    @id @default(cuid())
  descricao    String
  categoria    String
  tipo         TipoGasto @default(FIXO)
  valor        Float
  data         DateTime
  eventoId     String?
  evento       Evento?   @relation(fields: [eventoId], references: [id])
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
}
